# Copy to .env.local (gitignored) and fill in real values.
# Only EXPO_PUBLIC_* vars are readable from client code — never put the
# Supabase service-role key here, that lives in Railway's snag-api env only.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Flask backend (search/filter/notifications). localhost works for the iOS
# simulator; a physical device needs your Mac's LAN IP. Point this at the
# Railway URL once the backend is deployed.
EXPO_PUBLIC_API_URL=http://localhost:5001

# Only needed once Google sign-in is enabled in the Supabase dashboard
# (Authentication -> Providers -> Google) with a Web OAuth client ID/secret.
# Not required for Apple sign-in, and not required to run the app today.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
