# Copy to .env (gitignored) and fill in real values.
# Service-role key is the ONLY place this credential should live client-side
# of Supabase itself — never in the RN app or EAS env.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

FLASK_ENV=development
PORT=5001

# Tesla's inventory pages are behind Akamai bot protection that blocks
# direct requests from any datacenter IP (Railway included) — confirmed
# with raw requests, TLS-impersonated requests, and a real headless
# Chromium render, all denied. TeslaInventoryAdapter fetches through a
# residential-proxy scraping API instead. Sign up at scraperapi.com (or a
# similar provider) and paste the key here; hourly polling at MVP scale
# is well within free/low tiers.
SCRAPER_API_KEY=
