# Copy to .env (gitignored) and fill in real values.
# Service-role key is the ONLY place this credential should live client-side
# of Supabase itself — never in the RN app or EAS env.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

FLASK_ENV=development
PORT=5001

# Tesla's inventory pages are behind Akamai bot protection that blocks
# direct requests from any datacenter IP (Railway included) — confirmed
# with raw requests, TLS-impersonated requests, and a real headless
# Chromium render, all denied. TeslaInventoryAdapter fetches through a
# residential-proxy scraping API instead. Sign up at scraperapi.com (or a
# similar provider) and paste the key here; hourly polling at MVP scale
# is well within free/low tiers.
# NOTE: Tesla is parked post-pivot (see CLAUDE.md "Focus pivot") — this
# isn't needed to test the current search/tracking work below.
SCRAPER_API_KEY=

# eBay Browse API — developer.ebay.com, Production keyset (Sandbox only
# searches test inventory, not real listings). See
# docs/search-and-tracking-design.md "API setup steps" for the full flow.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Amazon Product Advertising API v5 — requires an Amazon Associates account
# with recent qualifying sales before PA-API access is granted. PartnerTag
# is your Associates tracking ID (e.g. yourtag-20). See
# docs/search-and-tracking-design.md "API setup steps".
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# SerpApi (serpapi.com) — Google Shopping search results, discovery-time
# only. Never used for polling an already-tracked listing; see
# docs/search-and-tracking-design.md §5.
SERPAPI_KEY=
